LEXMOUNT_API_KEY=your_api_key_here
LEXMOUNT_PROJECT_ID=your_project_id_here
# Optional: LEXMOUNT_REGION=your_catalog_region_id
# Optional: LEXMOUNT_BASE_URL=https://api.lexmount.cn

# Leave TARGET_URL unset to run the stable, controlled CSV demo.
# To download from a real page, set both values below.
# TARGET_URL=https://example.com/reports
# DOWNLOAD_LOCATOR=a[download]

# Optional output and wait settings.
# OUTPUT_DIR=artifacts/downloads
# DOWNLOAD_TIMEOUT_MS=60000
# DOWNLOAD_POLL_INTERVAL_MS=1000
