LEXMOUNT_API_KEY=your_api_key_here
LEXMOUNT_PROJECT_ID=your_project_id_here
# Optional: LEXMOUNT_REGION=your_catalog_region_id
# Optional: LEXMOUNT_BASE_URL=https://api.lexmount.cn
# Real human handoff target. Both URLs must use HTTPS and the same origin.
# Never place account credentials in this file.
TARGET_URL=https://gitee.com/login?redirect_to_url=%2Fdashboard%2Fprojects
SUCCESS_URL=https://gitee.com/dashboard/projects
# Optional: HANDOFF_TIMEOUT_SECONDS=600
# Optional: POLL_INTERVAL_MS=500
